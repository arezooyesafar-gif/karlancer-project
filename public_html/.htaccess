
# BEGIN Zioma
# درخواست‌های Ajax (هدر X-Requested-With) نباید نسخهٔ کش‌شدهٔ صفحه را از LiteSpeed بگیرند.
# توضیح کامل: wp-content/mu-plugins/zioma/cache-compat.php
<IfModule LiteSpeed>
RewriteEngine On
RewriteCond %{HTTP:X-Requested-With} ^XMLHttpRequest$ [NC]
RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
# کش مرورگر: فایل‌های ثابت (CSS، JS، فونت، تصویر، ویدیو) یک سال در مرورگر بازدیدکننده می‌مانند.
# فقط فایل‌های واقعی با این پسوندها؛ صفحه‌های HTML، Ajax و PHP شامل نمی‌شوند.
# وردپرس و LiteSpeed بعد از هر تغییر فایل، ?ver= یا نام فایل را عوض می‌کنند، پس نسخهٔ جدید گرفته می‌شود.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot|svg|ico|png|jpe?g|gif|webp|avif|mp4|webm)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
# END Zioma

# BEGIN WordPress
# دستورالعمل‌های (خطوط) بین "BEGIN WordPress" و "END WordPress"
# به طور پویا تولید شده‌اند، و فقط باید به وسیلهٔ صافی‌های وردرپرس ویرایش شوند.
# هر تغییری در دستورالعمل‌های بین این نشان‌گرها بازنویشی خواهند شد.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress